# Server-side only. Never prefix these values with VITE_ or expose them in client code.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
RATE_LIMIT_SALT=

# Optional: enables durable rate limiting across serverless instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional comma-separated full origins for preview/custom domains.
ALLOWED_ORIGINS=
